# --- Diisi otomatis oleh `neon deploy` (jangan commit .env) ---
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH="production"

NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json"

NEON_REALTIME_URL="wss://ep-xxx.rt.region.aws.neon.tech/"
NEON_REALTIME_SECRET="diisi-neon"
NEXT_PUBLIC_NEON_REALTIME_URL="wss://ep-xxx.rt.region.aws.neon.tech/"

AWS_ACCESS_KEY_ID="diisi-neon"
AWS_SECRET_ACCESS_KEY="diisi-neon"
AWS_ENDPOINT_URL_S3="https://br-xxx.storage.region.aws.neon.tech"
AWS_REGION="us-east-2"

NEON_FUNCTION_HELLO_BASE_URL="https://br-xxx-hello.compute.region.aws.neon.tech/"

# --- Diisi manual ---
# Minimal 32 karakter. Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="ganti-dengan-secret-acak-minimal-32-karakter"

# Shared secret untuk memanggil Neon Function `hello`.
# Nilai yang sama ditulis ke function oleh `neon deploy --env .env`.
INTERNAL_API_SECRET="ganti-dengan-secret-acak-minimal-32-karakter"

# Opsional: origin browser yang boleh membuka Realtime.
# Pisahkan dengan koma, mis. https://siposyandu.vercel.app
# REALTIME_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3100"

// Prisma schema untuk Sistem Informasi Posyandu Pede Seneng
// SQLite tidak mendukung enum, jadi role disimpan sebagai String.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String    @id @default(cuid())
  name         String
  username     String    @unique
  email        String    @unique
  passwordHash String
  /// ADMIN | KADER
  role         String    @default("KADER")
  isActive     Boolean   @default(true)
  /// Key objek avatar di Neon Object Storage (bucket "assets")
  avatarKey    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AuditLog[]

  @@index([role])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  email     String?
  userId    String?
  ip        String?
  userAgent String?
  detail    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Modul Posyandu (mengikuti Form_Posyandu_Pede_Seneng.xlsx)
// ---------------------------------------------------------------------------

/// Buku Pendaftaran — daftar sasaran + kehadiran Jan–Des.
model Sasaran {
  id             String    @id @default(cuid())
  no             Int?
  nama           String
  noKk           String?
  jenisKelamin   String?
  alamat         String?
  tanggalLahir   DateTime?
  kategoriLansia Boolean   @default(false)
  kategoriPtm    Boolean   @default(false)
  kategoriRemaja Boolean   @default(false)
  kategoriBalita Boolean   @default(false)
  noHp           String?
  /// { "JAN": true, "FEB": false, ... }
  kehadiran      Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([nama])
  @@index([kategoriBalita])
  @@index([kategoriLansia])
}


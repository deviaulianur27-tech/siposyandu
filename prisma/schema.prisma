/// Daftar Nama Laporan — BGM, T2, Bayi Baru Lahir, Bumil KEK, Bumil Anemia.
model LaporanKasus {
  id           String    @id @default(cuid())
  kategori     String
  nama         String
  namaOrangTua String?
  jenisKelamin String?
  tanggalLahir DateTime?
  tanggalUkur  DateTime?
  umurBulan    Int?
  bb           Float?
  tbLila       Float?
  hb           Float?
  keterangan   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([kategori])
  @@index([nama])
}

/// Laporan Hasil Kegiatan Posyandu (bulanan). Bagian rincian disimpan di data.
model LaporanBulanan {
  id         String    @id @default(cuid())
  posyandu   String    @default("Pede Seneng")
  tanggal    DateTime?
  dusun      String?
  desa       String?
  bulanTahun String?
  data       Json      @default("{}")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([bulanTahun])
}

  id               String    @id @default(cuid())
  nama             String
  nik              String?
  tanggalLahir     DateTime?
  namaSuami        String?
  alamat           String?
  noHp             String?
  dusun            String?
  desa             String?
  kecamatan        String?
  hamilAnakKe      Int?
  jarakAnak        String?
  beratBadanAwal   Float?
  tinggiBadan      Float?
  tanggalKunjungan DateTime?
  usiaKehamilan    Int?
  bb               Float?
  bbKurva          String?
  lila             Float?
  hasilLila        String?
  sistole          Int?
  diastole         Int?
  hasilTd          String?
  tbcBatuk         String?
  tbcDemam         String?
  tbcBbTurun       String?
  tbcKontak        String?
  hasilTbc         String?
  tabletDarah      String?
  jumlahTablet     Int?
  mtKek            String?
  kondisiMt        String?
  kelasIbuHamil    String?
  edukasi          String?
  rujuk            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([nama])
  @@index([tanggalKunjungan])
}

